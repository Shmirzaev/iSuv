{
  "name": "@isuv/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader runner --host 127.0.0.1",
    "build": "tsc -b && vite build --configLoader runner",
    "test": "pnpm --filter @isuv/i18n build && tsx --test src/**/*.test.ts src/**/*.test.tsx",
    "test:e2e": "playwright test --config playwright.config.ts --project=chromium"
  },
  "dependencies": {
    "@isuv/contracts": "workspace:*",
    "@isuv/i18n": "workspace:*",
    "@vitejs/plugin-react": "^5.0.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "vite": "^7.1.5"
  },
  "devDependencies": {
    "@playwright/test": "1.57.0",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9"
  }
}
